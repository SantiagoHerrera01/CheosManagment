generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
//  SEGURIDAD · usuarios y sesiones
// ============================================================

enum Role {
  ADMIN
  VENDEDOR
  BODEGA
  CONTADOR
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  fullName     String
  passwordHash String
  role         Role      @default(VENDEDOR)
  isActive     Boolean   @default(true)

  // Protección contra fuerza bruta
  failedLogins Int       @default(0)
  lockedUntil  DateTime?

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  refreshTokens RefreshToken[]
  invoices      Invoice[]           @relation("InvoiceCreatedBy")
  payments      Payment[]           @relation("PaymentCreatedBy")
  movements     InventoryMovement[] @relation("MovementCreatedBy")

  productionOrders ProductionOrder[] @relation("ProductionCreatedBy")
  expenses         Expense[]         @relation("ExpenseCreatedBy")
  purchases        Purchase[]        @relation("PurchaseCreatedBy")
  bankMovements    BankMovement[]    @relation("BankMovementCreatedBy")
}

/// Refresh tokens guardados hasheados (SHA-256): robar la BD no da sesiones vivas.
/// `replacedById` permite detectar reutilización de un token ya rotado.
model RefreshToken {
  id           String    @id @default(uuid())
  tokenHash    String    @unique
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  ip           String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  @@index([userId])
}

// ============================================================
//  CLIENTES (R1)
// ============================================================

enum DocumentType {
  CC
  NIT
  CE
  PASSPORT
}

model Client {
  id             String       @id @default(uuid())
  documentType   DocumentType
  documentNumber String       @unique
  fullName       String
  /// Puede faltar: la base original del cliente tiene registros sin celular.
  phone          String?
  email          String?
  address        String?
  city           String?
  department     String?
  notes          String?
  creditLimit    Decimal?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  invoices Invoice[]
}

// ============================================================
//  CATÁLOGO · productos, presentaciones y precios (R1)
// ============================================================

enum Grind {
  MOLIDO
  GRANO
}

/// Qué tipo de artículo es (R5): producto de venta, materia prima
/// (café en pergamino) o insumo/empaque (bolsas, adhesivos, posillos).
enum ProductCategory {
  TERMINADO
  MATERIA_PRIMA
  INSUMO
}

model Product {
  id          String   @id @default(uuid())
  name        String
  variety     String? // Castillo, Chiroso Urrao, Papayo Honey…
  process     String? // Lavado, Natural, Honey…
  category    ProductCategory @default(TERMINADO)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  presentations ProductPresentation[]
}

/// Una variante de venta = producto + presentación + molienda.
/// Acá vive el precio parametrizado, el costo interno (R7) y el stock (R3).
model ProductPresentation {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  label String // "250 g", "500 g", "1 kg"
  grind Grind

  price Decimal // precio de venta parametrizado (lo paga el cliente final)
  cost  Decimal @default(0) // costo interno de producción (NUNCA se expone al cliente)

  stock        Int    @default(0)
  minimumStock Int    @default(0) // umbral de alerta (R8)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     InvoiceItem[]
  movements InventoryMovement[]
  rawMaterialOf  ProductionOrder[]      @relation("OrderRawMaterial")
  outputOf       ProductionOrder[]      @relation("OrderOutput")
  purchaseItems  PurchaseItem[]

  @@unique([productId, label, grind])
  @@index([productId])
}

// ============================================================
//  FACTURACIÓN (R1) · CARTERA Y ABONOS (R2)
// ============================================================

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  CONTRA_ENTREGA
  CREDITO
  ABONO
}

enum InvoiceStatus {
  PENDIENTE
  PAGADA
  VENCIDA
  ANULADA
}

model Invoice {
  id      String @id @default(uuid())
  number  String @unique // consecutivo: F-000001

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  issueDate DateTime @default(now())
  dueDate   DateTime // vencimiento (30 días por defecto)

  subtotal Decimal @default(0)
  discount Decimal @default(0)
  total    Decimal @default(0)

  status        InvoiceStatus @default(PENDIENTE)
  paymentMethod PaymentMethod @default(EFECTIVO)
  notes         String?

  createdById String
  createdBy   User   @relation("InvoiceCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    InvoiceItem[]
  payments Payment[]

  @@index([clientId])
  @@index([status])
  @@index([dueDate])
  @@index([issueDate])
}

model InvoiceItem {
  id         String  @id @default(uuid())
  invoiceId  String
  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  presentationId String
  presentation   ProductPresentation @relation(fields: [presentationId], references: [id])

  // Snapshot: la factura no cambia aunque el producto se renombre o reprice
  productName       String
  presentationLabel String // "250 g · Molido"

  quantity  Int
  unitPrice Decimal
  subtotal  Decimal
  /// Costo interno al momento de vender (snapshot): permite calcular
  /// la utilidad del mes aunque el costo del producto cambie después (R7).
  unitCost  Decimal @default(0)

  @@index([invoiceId])
  @@index([presentationId])
}

/// Abonos y pagos sobre una factura (R2)
model Payment {
  id        String        @id @default(uuid())
  invoiceId String
  invoice   Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount Decimal
  method PaymentMethod
  paidAt DateTime      @default(now())
  notes  String?

  createdById String
  createdBy   User   @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([invoiceId])
}

// ============================================================
//  INVENTARIO (R3) · trazabilidad de movimientos
// ============================================================

enum MovementType {
  ENTRADA
  SALIDA
  AJUSTE
}

enum MovementReason {
  VENTA
  OBSEQUIO
  PRODUCCION
  COMPRA
  DEVOLUCION
  AJUSTE
  MERMA
}

model InventoryMovement {
  id             String             @id @default(uuid())
  presentationId String
  presentation   ProductPresentation @relation(fields: [presentationId], references: [id])

  type     MovementType
  reason   MovementReason
  quantity Int // siempre positivo; el signo lo determina `type`
  reference String? // nº de factura u orden de producción
  notes    String?

  createdById String
  createdBy   User     @relation("MovementCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([presentationId])
  @@index([createdAt])
}

// ============================================================
//  PRODUCCIÓN (R4) · órdenes, etapas y rendimiento
// ============================================================

enum ProductionStatus {
  EN_PROCESO
  FINALIZADA
  CANCELADA
}

/// Etapas del proceso: trilla (200 kg → 160 kg), tueste (160 → 150)…
enum ProductionStageType {
  TRILLA
  TUESTE
  LAVADO
  SECADO
  EMPAQUE
  OTRO
}

model ProductionOrder {
  id     String            @id @default(uuid())
  number String            @unique // consecutivo: OP-000001
  status ProductionStatus  @default(EN_PROCESO)

  /// Insumo/materia prima que entra (ej. café en pergamino).
  rawMaterialPresentationId String
  rawMaterialPresentation   ProductPresentation @relation("OrderRawMaterial", fields: [rawMaterialPresentationId], references: [id])

  /// Cantidad inicial de materia prima (kg).
  inputQuantity Int

  /// Presentación de producto terminado que se empaca al final.
  outputPresentationId String?
  outputPresentation   ProductPresentation? @relation("OrderOutput", fields: [outputPresentationId], references: [id])

  /// Unidades de producto terminado que entran a inventario.
  outputQuantity Int @default(0)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  notes      String?

  createdById String
  createdBy   User  @relation("ProductionCreatedBy", fields: [createdById], references: [id])

  stages ProductionStage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([startedAt])
}

/// Rendimiento por etapa: `inputQuantity` kg entran, `outputQuantity` kg
/// salen; la diferencia es la merma (R4).
model ProductionStage {
  id      String           @id @default(uuid())
  orderId String
  order   ProductionOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  type          ProductionStageType
  inputQuantity Int
  outputQuantity Int
  /// Merma calculada = input − output (se guarda para reportes).
  waste Int @default(0)
  notes String?

  sequence Int
  createdAt DateTime @default(now())

  @@index([orderId])
}

// ============================================================
//  GASTOS (R6) · utilidad mensual (R7)
// ============================================================

model Expense {
  id       String   @id @default(uuid())
  date     DateTime @default(now())
  concept  String // "Bolsas 250 g", "Domicilio San Francis", "Cintas"…
  amount   Decimal
  category String   @default("Operativo") // libre pero con sugerencias
  notes    String?

  createdById String
  createdBy   User   @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([category])
}

// ============================================================
//  COMPRAS A PROVEEDOR · ingreso a bodega (R3/R5)
// ============================================================

model Purchase {
  id       String   @id @default(uuid())
  number   String   @unique // consecutivo: C-000001
  provider String // "Eliseo Carvajal", "San Francis"…
  date     DateTime @default(now())
  total    Decimal  @default(0)
  notes    String?

  createdById String
  createdBy   User   @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items PurchaseItem[]

  @@index([date])
}

model PurchaseItem {
  id         String   @id @default(uuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  presentationId String
  presentation   ProductPresentation @relation(fields: [presentationId], references: [id])

  quantity  Int
  unitCost  Decimal
  subtotal  Decimal

  @@index([purchaseId])
}

// ============================================================
//  BANCOS · cuentas y movimientos
// ============================================================

model BankAccount {
  id      String  @id @default(uuid())
  name    String // "Bancolombia ahorros", "Efectivo caja"…
  bank    String
  accountNumber String?
  balance Decimal @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements BankMovement[]
}

model BankMovement {
  id      String @id @default(uuid())
  accountId String
  account   BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  type     MovementType // ENTRADA | SALIDA | AJUSTE
  amount   Decimal
  concept  String
  date     DateTime @default(now())

  createdById String
  createdBy   User   @relation("BankMovementCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([accountId])
  @@index([date])
}
