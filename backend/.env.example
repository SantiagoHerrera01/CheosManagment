# ============================================
# Cheo Manager API — variables de entorno
# Copia este archivo a `.env` y completa los valores:
#   cp .env.example .env
# ============================================

# Puerto del servidor Express
PORT=3000

# PostgreSQL (en Docker, compose.yaml define la suya propia)
# Modo DEV (por defecto): base de datos local
DATABASE_URL="postgresql://cheo:cheo_dev_password@localhost:5432/cheo_manager?schema=public"

# Modo PROD (NODE_ENV=production): base de datos de Render.
# Si está definida, se usa automáticamente en vez de DATABASE_URL.
# (En Render usa preferiblemente la Internal URL de tu BD)
DATABASE_URL_PROD=

# ---- Seguridad (OBLIGATORIOS en producción) ----
# Genera uno por variable con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Mínimo 32 caracteres. Si faltan, en desarrollo se usan valores locales de
# respaldo (con advertencia) y en producción la app NO arranca.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Duraciones (segundos)
ACCESS_TOKEN_TTL=900          # 15 minutos
REFRESH_TOKEN_TTL=604800      # 7 días

# Orígenes permitidos para el frontend, separados por coma
CORS_ORIGINS=http://localhost:5173

# Bloqueo de cuenta por fuerza bruta
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Entorno
NODE_ENV=development
